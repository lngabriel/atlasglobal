# Copy to .env and set a local password. Never commit .env.
DB_USERNAME=atlas
DB_PASSWORD=
DB_NAME=atlas_global
DB_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Production uses separate private Render/Neon settings, not the local Compose values above.
# See infrastructure/free-tier/backend.env.example and docs/deployment.md.
# Enter these privately in Render after choosing the assigned Pages project name:
# SPRING_PROFILES_ACTIVE=render
# DB_HOST=ep-replace-with-direct-endpoint.region.aws.neon.tech
# DB_NAME=replace-with-existing-neon-database
# DB_USERNAME=replace-with-neon-role
# DB_PASSWORD=replace-with-neon-password
# CORS_ALLOWED_ORIGINS=https://replace-with-assigned-project.pages.dev
# CACHE_ENABLED=true
# WORLD_BANK_SCHEDULE_ENABLED=false
# ADDITIONAL_SOURCES_SCHEDULE_ENABLED=false
# POLICY_RATE_SCHEDULE_ENABLED=false
# Render supplies PORT; use JAVA_TOOL_OPTIONS from render.yaml for the Free instance.
# Optional import scope (local operational commands, not startup jobs):
# WORLD_BANK_COUNTRIES=BRA,USA
# WORLD_BANK_FROM_YEAR=1960
# WORLD_BANK_TO_YEAR=0
# POLICY_RATE_FROM=2010-01-01
# WORLD_BANK_IMPORT_ONCE=false
# WORLD_BANK_IMPORT_CRON=0 0 3 * * SUN
# ADDITIONAL_SOURCES_IMPORT_CRON=0 0 5 * * SAT
# POLICY_RATE_IMPORT_CRON=0 0 4 * * *

# Public Pages build settings; configure in Pages or frontend/.env.local, never database secrets.
# NODE_VERSION=22.23.4
# SKIP_DEPENDENCY_INSTALL=1
# VITE_API_BASE_URL=https://replace-with-assigned-service.onrender.com
# VITE_API_TIMEOUT_MS=90000
