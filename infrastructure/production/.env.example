# Copy to infrastructure/production/.env and keep that file private.
DB_NAME=atlas_global
DB_USERNAME=atlas
DB_PASSWORD=replace-with-a-unique-production-password
CORS_ALLOWED_ORIGINS=https://atlas.example.com
FRONTEND_PORT=3000
# Use image digests reported by the manual release workflow.
ATLAS_BACKEND_IMAGE=ghcr.io/lngabriel/atlasglobal/backend@sha256:replace-with-verified-digest
ATLAS_FRONTEND_IMAGE=ghcr.io/lngabriel/atlasglobal/frontend@sha256:replace-with-verified-digest
CACHE_ENABLED=true
WORLD_BANK_SCHEDULE_ENABLED=false
ADDITIONAL_SOURCES_SCHEDULE_ENABLED=false
POLICY_RATE_SCHEDULE_ENABLED=false
